# ============================================================
# CampusLens backend config TEMPLATE - safe to commit.
# Copy this file to ".env" and fill in your own key.
# ============================================================

# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_goes_here

# Which Gemini model to use for image + text analysis.
# 3.8-flash is the model verified working by backend/test_gemini.py and the
# one used in the demo setup (.env). Older names may not be available.
GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------
# PostgreSQL connection string (optional - deployment only).
# This is the full PostgreSQL URL used instead of local SQLite when set;
# leave it unset or blank locally to keep using SQLite. The legacy
# "postgres://" spelling is normalized to "postgresql://" automatically.
# Kept commented out so a fresh copy of this template stays on SQLite.
# NEVER put a real credential in this committed file - the placeholder
# below is intentionally fake. Set your real URL only in your own
# uncommitted ".env" (or in the hosting platform's environment).
# DATABASE_URL=postgresql://user:password@host:5432/dbname
