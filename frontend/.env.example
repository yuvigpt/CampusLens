# Base URL of the CampusLens FastAPI backend.
# No trailing slash. Vite exposes this to the browser as import.meta.env.VITE_*,
# so only VITE_-prefixed variables are bundled - never put API keys here.
# The Gemini key stays in backend/.env and must never appear here.
VITE_API_BASE_URL=http://127.0.0.1:8000
